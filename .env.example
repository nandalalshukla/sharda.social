# Origin of the Sharda Social backend, with no path and no trailing slash.
# The app appends /api/v1 itself.
#
#   Production:           https://your-backend.onrender.com
#   Android emulator:     http://10.0.2.2:5000
#   iOS simulator:        http://localhost:5000
#   Physical device:      http://<your-computer-LAN-IP>:5000
#
# In development, if this is left unset the app falls back to the machine
# running Metro (port 5000), which is what you want for a physical device on
# the same Wi-Fi. A production build refuses to start without it.
EXPO_PUBLIC_API_URL=https://notes-pyqssharda-backend.onrender.com
