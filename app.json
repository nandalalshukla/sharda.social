{
  "expo": {
    "name": "Sharda Social",
    "slug": "sharda-social",
    "scheme": "shardasocial",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf9fd",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "social.sharda.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "social.sharda.app",
      "adaptiveIcon": {
        "backgroundColor": "#012262",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#100e1a",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sharda Social needs access to your photos so you can attach images to posts and set a profile picture.",
          "cameraPermission": "Sharda Social uses the camera so you can take a profile picture or photograph a lost item."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker"
    ]
  }
}
